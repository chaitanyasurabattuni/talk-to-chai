# Groq API key — get a free one at https://console.groq.com/keys
# Set this in your local .env for `vercel dev`, and in your Vercel/Cloudflare project settings for production.
GROQ_API_KEY=gsk_your_key_here

# Model the chat agent speaks with (fast, free tier). Optional override.
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Smaller/faster model used by the LLM-as-judge eval call. Optional override.
GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# Fallback chat model used automatically if the primary chat model hits a rate/token
# limit (graceful degradation — keeps the chat alive on the free tier). Optional override.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
